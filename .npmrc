# NOTE: pnpm 10+/11 reads its OWN settings from pnpm-workspace.yaml, not here.
# The supply-chain controls (ignoreScripts, blockExoticSubdeps,
# minimumReleaseAge, saveExact, preferFrozenLockfile) live in that file.
# Anything pnpm-specific added here is silently ignored — do not add it.
registry=https://registry.npmjs.org/
